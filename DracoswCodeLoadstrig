local function pararCaminhadaArea()
    if walkThread then
        task.cancel(walkThread)
        walkThread = nil
    end
    local character = plr.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = 16
        pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Idle) end)
    end
end

btnTeleporte.MouseButton1Click:Connect(function()
    teleporteAtivo = not teleporteAtivo
    configsSalvas.Teleporte = teleporteAtivo
    salvarConfig()
    atualizarTeleporteVisual()
    
    if teleporteAtivo then
        local character = plr.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if hrp and humanoid then
            local destinoPos = areas[modoAtualIndex].cframe.Position

            walkThread = task.spawn(function()
                while teleporteAtivo and character and character.Parent do
                    local posAtual = hrp.Position
                    local vetDirecao = (destinoPos - posAtual)
                    local vetHorizontal = Vector3.new(vetDirecao.X, 0, vetDirecao.Z)
                    local dist = vetHorizontal.Magnitude

                    if dist <= 5 then
                        break
                    end

                    local dir = vetHorizontal.Unit
                    humanoid.WalkSpeed = VELOCIDADE_ALVO
                    hrp.AssemblyLinearVelocity = Vector3.new(dir.X * VELOCIDADE_ALVO, hrp.AssemblyLinearVelocity.Y, dir.Z * VELOCIDADE_ALVO)
                    hrp.CFrame = CFrame.new(posAtual, posAtual + dir)

                    pcall(function()
                        humanoid:ChangeState(Enum.HumanoidStateType.Running)
                    end)

                    RunService.RenderStepped:Wait()
                end

                teleporteAtivo = false
                configsSalvas.Teleporte = false
                salvarConfig()
                atualizarTeleporteVisual()
                pararCaminhadaArea()
            end)
        end
    else
        pararCaminhadaArea()
    end
end)

