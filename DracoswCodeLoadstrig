local function carregarConfig()
    if pcall(function() readfile(NOME_ARQUIVO) end) then
        local sucesso, dados = pcall(function()
            return HttpService:JSONDecode(readfile(NOME_ARQUIVO))
        end)
        if sucesso and type(dados) == "table" then
            for k, v in pairs(dados) do
                configsSalvas[k] = v
            end
        end
    end
end

local function salvarConfig()
    pcall(function()
        writefile(NOME_ARQUIVO, HttpService:JSONEncode(configsSalvas))
    end)
end

