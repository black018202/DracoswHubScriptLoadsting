-- 5. ESP Player
local function removerEsp(otherPlr)
    if espHighlights[otherPlr] then
        pcall(function() espHighlights[otherPlr]:Destroy() end)
        espHighlights[otherPlr] = nil
    end
    if otherPlr.Character then
        local head = otherPlr.Character:FindFirstChild("Head")
        if head then
            local tag = head:FindFirstChild("DracoswESP_Tag")
            if tag then tag:Destroy() end
        end
    end
end

local function atualizarEspParaJogador(otherPlr)
    if otherPlr == plr then return end
    local char = otherPlr.Character
    if not espAtivo or not char or not char:FindFirstChild("HumanoidRootPart") then
        removerEsp(otherPlr)
        return
    end

    local hl = espHighlights[otherPlr]
    if not hl or not hl.Parent then
        hl = Instance.new("Highlight")
        hl.Name = "DracoswESP_Highlight"
        hl.FillColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Adornee = char
        hl.Parent = char
        espHighlights[otherPlr] = hl
    else
        hl.Adornee = char
    end

    local head = char:FindFirstChild("Head")
    if head then
        local tag = head:FindFirstChild("DracoswESP_Tag")
        if not tag then
            tag = Instance.new("BillboardGui")
            tag.Name = "DracoswESP_Tag"
            tag.Size = UDim2.new(0, 100, 0, 40)
            tag.StudsOffset = Vector3.new(0, 2.5, 0)
            tag.AlwaysOnTop = true
            tag.Parent = head

            local txt = Instance.new("TextLabel")
            txt.Name = "TextoNick"
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 12
            txt.TextColor3 = Color3.fromRGB(255, 255, 255)
            txt.TextStrokeTransparency = 0
            txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            txt.Text = otherPlr.Name
            txt.Parent = tag
        end
    end
end

