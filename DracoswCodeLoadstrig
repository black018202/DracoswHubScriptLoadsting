-- 4. Anti Ragdol
local function removeAnimations(char)
    if not char then return end
    local animateScript = char:FindFirstChild("Animate")
    if animateScript then animateScript.Disabled = true end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                track:Stop()
            end
        end
    end
end

if plr.Character then removeAnimations(plr.Character) end
plr.CharacterAdded:Connect(function(char)
    task.wait(0.2)
    removeAnimations(char)
end)

RunService.RenderStepped:Connect(function()
    if not antiRagdolAtivo then return end
    local character = plr.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    
    if humanoid and humanoidRootPart then
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                track:Stop()
            end
        end
        
        if not runningRagdoll then
            local isTilted = false
            if head then
                local upVector = head.CFrame.UpVector
                if upVector.Y < 0.4 then isTilted = true end
            end
            
            local currentState = humanoid:GetState()
            local isRagdollState = (currentState == Enum.HumanoidStateType.Ragdoll 
                or currentState == Enum.HumanoidStateType.PlatformStanding 
                or currentState == Enum.HumanoidStateType.FallingDown
                or currentState == Enum.HumanoidStateType.Physics)
            
            local jointsBroken = false
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then
                    for _, joint in ipairs(part:GetChildren()) do
                        if joint:IsA("Motor6D") and (joint.Part0 == nil or joint.Part1 == nil) then
                            jointsBroken = true
                        end
                    end
                end
            end
            
            if isTilted or isRagdollState or jointsBroken then
                runningRagdoll = true
                autoDisableTick = tick() + 0.9
            end
        end
    end
    
    if runningRagdoll then
        if tick() >= autoDisableTick then
            runningRagdoll = false
        end
        
        if humanoidRootPart and humanoid then
            humanoid.WalkSpeed = 16 
            pcall(function()
                humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end)
            
            local camLookVector = camera.CFrame.LookVector
            local moveDir = Vector3.new(camLookVector.X, 0, camLookVector.Z).Unit
            humanoidRootPart.AssemblyLinearVelocity = Vector3.new(moveDir.X * fixedSpeedRagdoll, 0, moveDir.Z * fixedSpeedRagdoll)
            humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position, humanoidRootPart.Position + moveDir)
        end
    end
end)

