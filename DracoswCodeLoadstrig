-- 3. GO UP (SERA UP) - SOBE CADA 0.5s E DESLIGA/PAUSA 1s
-- ============================================================
local function ligarSeraUp()
    if seraUpThread then task.cancel(seraUpThread) end
    
    seraUpThread = task.spawn(function()
        while seraUpAtivo do
            local character = plr.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Sobe
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 25, 0)
                
                -- Cria a plataforma invisível
                local part = Instance.new("Part")
                part.Size = Vector3.new(200, 1, 200)
                part.Position = hrp.Position - Vector3.new(0, 3.5, 0)
                part.Anchored = true
                part.CanCollide = true
                part.Transparency = 1
                part.Parent = Workspace
                
                -- Fica ativo por 500 milissegundos (0.5s)
                task.wait(0.5)
                
                if part then part:Destroy() end
            end
            
            -- Fica desativado/pausado por 1 segundo antes de subir de novo
            task.wait(1)
        end
    end)
end

local function desligarSeraUp()
    if seraUpThread then
        task.cancel(seraUpThread)
        seraUpThread = nil
    end
end

btnSeraUp.MouseButton1Click:Connect(function()
    seraUpAtivo = not seraUpAtivo
    configsSalvas.SeraUp = seraUpAtivo
    salvarConfig()
    atualizarSeraUpVisual()
    
    if seraUpAtivo then
        ligarSeraUp()
    else
        desligarSeraUp()
    end
end)

if seraUpAtivo then
    task.spawn(function()
        task.wait(1)
        ligarSeraUp()
    end)
end

